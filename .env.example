# Copy profiles/gfx803-vulkan.env to .env and adjust host group IDs if needed.
PROFILE_NAME=gfx803-vulkan
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.17.2
NCNN_TAG=20260526
NCNN_FP16=0
VIDEO_GID=44
RENDER_GID=109
# Corvette issue #2 (D2): build args for docker/Dockerfile.py313 only, which
# no compose service builds yet (`docker buildx build` directly, see
# docs/vulkan-notes.md). Mirrored here alongside FRIGATE_IMAGE/NCNN_TAG for
# when that wiring happens. CORVETTE_UI_IMAGE must stay digest-pinned
# (INV-4) -- never edit this to a bare tag.
CORVETTE_VERSION=20260829
CORVETTE_UI_IMAGE=docker.io/cvandesande/corvette-ui:20260829@sha256:3bbdd4f0564594dedfa498ae9b9c655d03517407f63b0f7427f37f5cd326440c
